# Uygulama
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (NextAuth) — Vercel env olarak ayarlayın. Üretmek için: openssl rand -base64 32
AUTH_SECRET=change-me-with-openssl-rand-base64-32
AUTH_USERNAME=admin
AUTH_PASSWORD=degistir-bunu

# LLM (AI Chat) — opsiyonel, anahtar girilince chat gerçek yanıtlar üretir
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# TCMB EVDS API anahtarı (opsiyonel)
EVDS_API_KEY=

# (VPS/Docker seçeneği) Veritabanı & Cache — Vercel'de gerekmez
DATABASE_URL=postgresql://borsa:borsa@localhost:5432/borsa
REDIS_URL=redis://localhost:6379